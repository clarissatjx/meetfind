# Postgres (Neon / Vercel Postgres / Supabase / local). Required.
DATABASE_URL=postgres://user:pass@host:5432/meetfind
# Public origin, used for the Google OAuth redirect URI. Optional (derived from the request if unset).
BASE_URL=http://localhost:3000
# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
